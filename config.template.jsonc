    "MegaDL.Enabled": true,
    "MegaDL.WebhookUrl": "https://www.example.com", // HTTP_WEB_HOOK
    "MegaDL.WebhookToken": "", // Bearer token without 'Bearer '
    "YtDL.Enabled": true,
